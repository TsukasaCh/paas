# ── .env PRODUCTION — salin ke root repo sebagai `.env` ────────
# Ganti SEMUA nilai bertanda <…>. Jangan pernah commit file ini.
#
# Bikin secret acak:  openssl rand -hex 32
#
# PENTING: file ini dibaca systemd (EnvironmentFile) yang TIDAK paham komentar
# inline. Taruh komentar di baris sendiri — JANGAN `KEY="val"  # komentar`.

# ── Database ───────────────────────────────────────────────────
# Postgres (disarankan). Ambil dari /root/db-url.txt bila memakai
# bootstrap-ec2.sh, atau dari endpoint RDS.
# WAJIB: ubah provider di packages/db/prisma/schema.prisma → "postgresql"
DATABASE_URL="postgresql://ronaldocloud:<password>@localhost:5432/ronaldocloud"

# ── Kunci rahasia ──────────────────────────────────────────────
# SECRET_KEY mengenkripsi env var user, githubToken, & API token Cloudflare.
# BACKUP TERPISAH — hilang berarti semua secret lama tak bisa dibuka.
SECRET_KEY="<openssl rand -hex 32>"
NEXTAUTH_SECRET="<openssl rand -hex 32>"
INTERNAL_JWT_SECRET="<openssl rand -hex 32>"

# ── Operator (Admin Console di /admin/login) ───────────────────
ADMIN_USERNAME="<username admin>"
ADMIN_PASSWORD="<password kuat>"

# ── Domain & URL publik ────────────────────────────────────────
NEXTAUTH_URL="https://<domain-dashboard>"
API_PUBLIC_URL="https://<domain-api>"
# AGENT_PUBLIC_URL WAJIB wss:// (TLS) di produksi.
AGENT_PUBLIC_URL="wss://<domain-api>/agent"
NEXT_PUBLIC_API_URL="https://<domain-api>"

# Domain aplikasi user. Ini hanya FALLBACK — yang dipakai adalah setelan
# di Admin Console → Domain & DNS.
APP_DOMAIN="<domain-aplikasi>"
APP_SCHEME="https"
PROXY_PORT=8080

# ── Keamanan bind ──────────────────────────────────────────────
# Hanya Caddy yang boleh terbuka ke internet.
BIND_ADDRESS="127.0.0.1"

# ── Runtime deploy ─────────────────────────────────────────────
# "node"   = jalankan app sebagai proses (tanpa Docker) — default aman.
# "docker" = wajib bila ingin sumber Docker Image / Database
#            (butuh Docker terpasang: bootstrap TANPA INSTALL_DOCKER=no).
DEPLOY_RUNTIME="node"
# QUEUE_DRIVER=memory cukup selama API satu proses (tanpa Redis).
# Set "redis" + REDIS_URL hanya bila menjalankan worker BullMQ terpisah.
QUEUE_DRIVER="memory"
PORT_RANGE_START=20000
PORT_RANGE_END=30000
WORKSPACE_DIR="/var/lib/ronaldocloud/workspaces"

# ── GitHub OAuth (opsional; untuk login GitHub & repo privat) ──
# Callback: https://<domain-dashboard>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET="<openssl rand -hex 32>"
