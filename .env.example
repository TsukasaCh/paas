# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://minipaas:minipaas@localhost:5432/minipaas?schema=public"

# ─── Redis (BullMQ + pub/sub log) ──────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── GitHub OAuth (NextAuth) ───────────────────────────────
# Buat OAuth App di https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"

# ─── Operator (Admin Console) ──────────────────────────────
# WAJIB diganti di produksi & jangan pernah di-commit.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# ─── Kunci enkripsi secret at-rest ─────────────────────────
# Dipakai mengenkripsi API token Cloudflare di DB (AES-256-GCM).
# JANGAN diganti setelah ada data — secret lama tak akan bisa didekripsi.
SECRET_KEY="ganti-dengan-string-acak-panjang-khusus-enkripsi"

# ─── Token internal web → api ──────────────────────────────
# Dipakai @minipaas/auth untuk menandatangani/verifikasi JWT internal.
# WAJIB sama di web & api. Jika kosong, fallback ke NEXTAUTH_SECRET.
INTERNAL_JWT_SECRET="ganti-dengan-string-acak-panjang-lain"

# ─── URL antar service ─────────────────────────────────────
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── URL publik (dipakai di perintah instalasi agent) ──────
# Produksi: API_PUBLIC_URL="https://api.ronaldocloud.id"
#           AGENT_PUBLIC_URL="wss://api.ronaldocloud.id/agent"   ← WAJIB wss:// (TLS)
API_PUBLIC_URL="http://localhost:4000"
AGENT_PUBLIC_URL="ws://localhost:4000/agent"

# ─── Webhook GitHub ────────────────────────────────────────
GITHUB_WEBHOOK_SECRET="ganti-dengan-secret-webhook"

# ─── Worker / Runtime deployment ───────────────────────────
# Pilih mesin deploy: "docker" (build+run container) atau "node"
# (jalankan app Node sebagai child process, TANPA Docker).
DEPLOY_RUNTIME="docker"
# Range port publik yang dialokasikan untuk app
PORT_RANGE_START=20000
PORT_RANGE_END=30000
# Lokasi kerja clone repo sementara
WORKSPACE_DIR="./.workspaces"
